{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "exture",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "build": {"command": "node scripts/build-cloudflare.mjs"},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [{"name": "STORE", "class_name": "LearningStore"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LearningStore"]}],
  "rules": [{"type": "Text", "globs": ["**/config/tags/*.html"], "fallthrough": true}]
}
