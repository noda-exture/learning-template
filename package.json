{
  "name": "learning-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node src/server.mjs",
    "start": "node src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "cf:setup": "node scripts/setup-cloudflare.mjs",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "cf:dev": "wrangler dev --config wrangler.local.json",
    "cf:deploy": "wrangler deploy --config wrangler.local.json",
    "cf:check": "wrangler deploy --dry-run --outdir .generated/worker"
  },
  "devDependencies": {
    "wrangler": "^4.159.0"
  }
}
